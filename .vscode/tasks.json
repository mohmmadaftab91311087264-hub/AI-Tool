{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verify Developer Kit",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/verify-kit.ps1",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command"
          ]
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run .NET starter",
      "type": "shell",
      "command": "dotnet run --project \"${workspaceFolder}/StarterProjects/DotnetApp/DotnetApp.csproj\"",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build .NET starter",
      "type": "shell",
      "command": "dotnet build \"${workspaceFolder}/StarterProjects/DotnetApp/DotnetApp.csproj\"",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Node starter",
      "type": "shell",
      "command": "npm start --prefix \"${workspaceFolder}/StarterProjects/NodeApp\"",
      "problemMatcher": []
    },
    {
      "label": "Run Python starter",
      "type": "shell",
      "command": "python \"${workspaceFolder}/StarterProjects/PythonApp/main.py\"",
      "problemMatcher": []
    },
    {
      "label": "Test WebApp",
      "type": "shell",
      "command": "npm test --prefix \"${workspaceFolder}/StarterProjects/WebApp\"",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Start WebApp",
      "type": "shell",
      "command": "npm start --prefix \"${workspaceFolder}/StarterProjects/WebApp\"",
      "problemMatcher": []
    },
    {
      "label": "Smoke Test WebApp Endpoint",
      "type": "shell",
      "command": "node -e \"const http=require('node:http'); const req=http.get('http://127.0.0.1:3000', res => { if (res.statusCode !== 200) process.exit(1); console.log('WebApp smoke test passed'); res.resume(); }); req.on('error', () => process.exit(1));\"",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
