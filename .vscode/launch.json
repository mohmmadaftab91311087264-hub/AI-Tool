{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug WebApp",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/StarterProjects/WebApp/server.js",
      "env": {
        "PORT": "3000"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Run Python starter",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/StarterProjects/PythonApp/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug .NET starter",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build .NET starter",
      "program": "${workspaceFolder}/StarterProjects/DotnetApp/bin/Debug/net10.0/DotnetApp.dll",
      "cwd": "${workspaceFolder}/StarterProjects/DotnetApp",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
